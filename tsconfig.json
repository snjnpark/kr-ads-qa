{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@test-support": [
        "./src/server/test-support-disabled.ts"
      ],
      "@browser-runtime": [
        "./src/browser/runtime-factory.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "next.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "data",
    "output",
    "src/server/api.ts",
    "src/server/application.ts",
    "src/server/application/settings.ts",
    "src/server/application/query.ts",
    "src/server/ai.ts",
    "src/server/credentials.ts",
    "src/server/storage.ts",
    "src/server/rules.ts",
    "src/server/policies/repository.ts",
    "src/server/platforms/index.ts",
    "src/server/laya-bundle.ts",
    "src/server/model-release.ts",
    "src/server/condition-classifier.ts",
    "src/server/test-support-disabled.ts"
  ]
}
