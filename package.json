{
  "name": "kr-ads-qa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "dev": "node deployment/run.mjs dev --turbopack --hostname 127.0.0.1 --port 8080",
    "build": "node deployment/run.mjs build --webpack",
    "start": "node deployment/run.mjs start --hostname 127.0.0.1 --port 8080",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests-ts tests-integration e2e scripts testing playwright.config.ts",
    "test": "tsx scripts/test.ts all",
    "test:runtime": "tsx scripts/test.ts all --stage runtime",
    "test:learning": "tsx scripts/test.ts all --stage learning",
    "test:compatibility": "tsx scripts/test.ts all --stage compatibility",
    "test:tooling": "tsx scripts/test.ts all --stage tooling",
    "test:qa": "tsx scripts/test.ts qa",
    "test:policies": "tsx scripts/test.ts policies",
    "test:platforms": "tsx scripts/test.ts platforms",
    "test:naver": "tsx scripts/test.ts naver",
    "test:kakao": "tsx scripts/test.ts kakao",
    "test:google": "tsx scripts/test.ts google",
    "test:fixtures": "tsx scripts/test.ts fixtures",
    "test:query": "tsx scripts/test.ts query",
    "test:storage": "tsx scripts/test.ts storage",
    "test:security": "tsx scripts/test.ts security",
    "test:ai": "tsx scripts/test.ts ai",
    "test:ui": "tsx scripts/test.ts ui",
    "test:tools": "tsx scripts/test.ts tools",
    "test:file": "tsx scripts/test.ts all --files",
    "test:changed": "tsx scripts/test.ts all --changed",
    "test:fuzz": "tsx scripts/test.ts fuzz",
    "test:stress": "tsx scripts/test.ts fuzz --cases 1000",
    "test:coverage": "tsx scripts/test.ts all --coverage",
    "test:coverage:core": "tsx scripts/test.ts core --coverage --strict",
    "test:coverage:strict": "tsx scripts/test.ts all --coverage --strict",
    "test:mutation": "tsx testing/run.ts tsx scripts/mutate.ts",
    "fixtures:generate": "tsx testing/run.ts tsx scripts/generate-api-fixtures.ts",
    "test:contracts": "tsx scripts/test.ts contracts",
    "test:pipeline": "tsx testing/run.ts tsx --test tests-integration/semantic-pipeline.test.ts",
    "test:e2e": "npm run build:test && playwright test --project=browser",
    "test:e2e:journey": "npm run test:e2e",
    "test:e2e:run": "playwright test",
    "test:validation": "npm run lint && npm run typecheck && npm run typecheck:test && npm test && npm run test:coverage:core && npm run test:fixtures -- --coverage --strict && npm run build:test && playwright test --project=browser",
    "test:thorough": "npm run test:validation && npm run test:coverage && npm run test:mutation && npm run test:stress",
    "dev:test": "tsx scripts/run-app.ts test dev --hostname 127.0.0.1 --port 8082",
    "build:test": "tsx scripts/run-app.ts test build",
    "start:test": "tsx scripts/run-app.ts test start --hostname 127.0.0.1 --port 8082",
    "test:e2e:products": "npm run test:e2e",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json --incremental false"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.59.0",
    "luxon": "^3.7.2",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "onnxruntime-web": "1.30.0",
    "hash-wasm": "4.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "c8": "^12.0.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "fake-indexeddb": "6.2.6",
    "@receptron/laya": "0.2.0",
    "@napi-rs/keyring": "^2.1.1",
    "onnxruntime-node": "1.30.0"
  },
  "license": "MIT"
}
