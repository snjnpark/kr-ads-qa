# API credentials are entered in browser Settings and live only in that tab.
# Never put advertising API keys/tokens in server or NEXT_PUBLIC environment variables.

# Optional: exact public HTTPS origin when self-hosting behind a reverse proxy.
# LAYA_PUBLIC_ORIGIN=https://ads.example.com

# Optional: public CORS-enabled host for the four application adaptation files.
# Default: versioned same-origin static files, prepared automatically at build time.
# Upstream model/tokenizer downloads always use the pinned original Hugging Face URLs.
# This value is public. Do not include credentials or private/signed URLs.
# NEXT_PUBLIC_LAYA_MODEL_BASE_URL=https://models.example.com/laya-release/
